  "cards": [
    {
      "dot": "cyan",
      "title": "Provisioning and ownership",
      "items": [
        "Operator applies foundation. After lint, CI applies dev and prod independently; each runs cluster then platform.",
        "OpenTofu owns the fixed control plane and bootstrap; Karpenter owns every AWS worker. No ASG.",
        "Argo CD and ESO run independently. argocd-post owns namespaces and Argo access; Kubeflow owns ML credentials. Apps are omitted."
      ]
    },
    {
      "dot": "amber",
      "title": "Capacity and scaling",
      "items": [
        "Dev: pve 8 CPU / 32 GiB + GPU; pve2 8 / 16; pve3 4 / 16. Independent AWS Spot pool scales from zero.",
        "Prod baseline: three m6a.xlarge nodes, 12 vCPU / 48 GiB total. One control plane, not HA.",
        "Each Spot pool scales from pending pod requests up to one worker. Prod permits one extra baseline node during replacement. GPU pools disabled."
      ]
    },
    {
      "dot": "violet",
      "title": "Storage and access boundaries",
      "items": [
        "Dev uses external MinIO and node-local PVCs; a Spot disk is ephemeral. Prod uses regional S3 and same-AZ gp3 PVCs, without multi-AZ HA.",
        "S3 prefixes hold lakehouse, artifacts, datasets, runs and backups. PVCs are separate; selected storage paths are shown.",
        "Dev management uses LAN/Tailscale; prod uses allowlisted EIP ports. Cloudflare tunnels expose ClusterIP services. No API VIP or LAN load balancer."
      ]
    }
  ]
}
