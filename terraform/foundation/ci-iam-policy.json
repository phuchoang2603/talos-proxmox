{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateNamedKarpenterUsersAndPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreateUser",
        "iam:CreatePolicy"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:user/talos-proxmox-karpenter-*",
        "arn:aws:iam::ACCOUNT_ID:policy/talos-proxmox-karpenter-*",
        "arn:aws:iam::ACCOUNT_ID:user/platform-prod-ebs-csi"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed-by": "talos-proxmox"
        }
      }
    },
    {
      "Sid": "ManageNamedKarpenterUsersAndPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:DeleteUser",
        "iam:TagUser",
        "iam:UntagUser",
        "iam:ListUserTags",
        "iam:ListUserPolicies",
        "iam:ListAttachedUserPolicies",
        "iam:ListGroupsForUser",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:ListPolicyTags",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:user/talos-proxmox-karpenter-*",
        "arn:aws:iam::ACCOUNT_ID:policy/talos-proxmox-karpenter-*",
        "arn:aws:iam::ACCOUNT_ID:user/platform-prod-ebs-csi"
      ]
    },
    {
      "Sid": "ManageNamedKarpenterAccessKeys",
      "Effect": "Allow",
      "Action": [
        "iam:CreateAccessKey",
        "iam:DeleteAccessKey",
        "iam:ListAccessKeys"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:user/talos-proxmox-karpenter-*",
        "arn:aws:iam::ACCOUNT_ID:user/platform-prod-ebs-csi"
      ]
    },
    {
      "Sid": "AttachOnlyNamedKarpenterPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:AttachUserPolicy",
        "iam:DetachUserPolicy"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:user/talos-proxmox-karpenter-*",
        "arn:aws:iam::ACCOUNT_ID:user/platform-prod-ebs-csi"
      ],
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": "arn:aws:iam::ACCOUNT_ID:policy/talos-proxmox-karpenter-*"
        }
      }
    },
    {
      "Sid": "CreateWorkerRoleAndProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:CreateInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/*-talos-worker",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/*-talos-worker"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed-by": "talos-proxmox"
        }
      }
    },
    {
      "Sid": "ManageWorkerRoleAndProfile",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:GetInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile",
        "iam:ListInstanceProfileTags",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/*-talos-worker",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/*-talos-worker"
      ]
    },
    {
      "Sid": "PassOnlyWorkerRoleToInstanceProfile",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/*-talos-worker",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageScopedControllerInlinePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:PutUserPolicy",
        "iam:GetUserPolicy",
        "iam:DeleteUserPolicy"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:user/platform-prod-ebs-csi",
        "arn:aws:iam::ACCOUNT_ID:user/talos-proxmox-karpenter-dev",
        "arn:aws:iam::ACCOUNT_ID:user/talos-proxmox-karpenter-prod"
      ]
    }
  ]
}
