{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::platform-dev"
      ]
    },
    {
      "Sid": "ListPurposePrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::platform-dev"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "artifacts",
            "artifacts/*",
            "datasets",
            "datasets/*",
            "runs",
            "runs/*"
          ]
        }
      }
    },
    {
      "Sid": "ManagePurposeObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::platform-dev/artifacts/*",
        "arn:aws:s3:::platform-dev/datasets/*",
        "arn:aws:s3:::platform-dev/runs/*"
      ]
    }
  ]
}
