{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "cluster",
    "repoURL",
    "targetRevision"
  ],
  "properties": {
    "cluster": {
      "type": "string",
      "enum": [
        "dev",
        "prod"
      ]
    },
    "repoURL": {
      "type": "string",
      "minLength": 1
    },
    "targetRevision": {
      "type": "string",
      "minLength": 1
    },
    "gateway": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "backendService": {
          "type": "string",
          "minLength": 1
        },
        "backendPort": {
          "type": "integer"
        }
      }
    }
  }
}
