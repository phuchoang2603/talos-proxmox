{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "cluster",
    "repoURL",
    "targetRevision"
  ],
  "properties": {
    "cluster": {
      "type": "string",
      "enum": [
        "dev",
        "prod"
      ]
    },
    "repoURL": {
      "type": "string",
      "minLength": 1
    },
    "targetRevision": {
      "type": "string",
      "minLength": 1
    }
  }
}
