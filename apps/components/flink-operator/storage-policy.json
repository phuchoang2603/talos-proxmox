{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::fraud-flink-prod"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketMultipartUploads"],
      "Resource": ["arn:aws:s3:::fraud-flink-prod"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["checkpoints", "checkpoints/*", "savepoints", "savepoints/*"]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::fraud-flink-prod/checkpoints/*",
        "arn:aws:s3:::fraud-flink-prod/savepoints/*"
      ]
    }
  ]
}
