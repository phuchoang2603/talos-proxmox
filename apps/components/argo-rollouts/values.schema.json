{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["argo-rollouts", "gatewayPlugin"],
  "properties": {
    "argo-rollouts": {
      "type": "object"
    },
    "gatewayPlugin": {
      "type": "object",
      "required": ["serviceAccountName"],
      "properties": {
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
