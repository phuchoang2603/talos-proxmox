---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: argo-cd-ingressroute
  namespace: argo-cd
spec:
  entryPoints:
    - websecure
    - web
  routes:
    - match: Host(`argo.${SSL_LOCAL_DOMAIN}`) && PathPrefix(`/`)
      kind: Rule
      services:
        - name: argo-cd-argocd-server
          port: 80
