apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argo-cd
  namespace: argo-cd
spec:
  parentRefs:
    - name: cilium
      namespace: cilium-ingress
      sectionName: https
  hostnames:
    - argo.${SSL_LOCAL_DOMAIN}
  rules:
    - backendRefs:
        - name: argo-cd-argocd-server
          port: 80
