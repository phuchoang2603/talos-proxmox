apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: hubble
  namespace: kube-system
spec:
  parentRefs:
    - name: cilium
      namespace: cilium-ingress
      sectionName: https
  hostnames:
    - hubble.${SSL_LOCAL_DOMAIN}
  rules:
    - backendRefs:
        - name: hubble-ui
          port: 80
