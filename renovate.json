{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpdateOptions": [
    "helmUpdateSubChartArchives"
  ],
  "schedule": [
    "on the first day of the month"
  ],
  "dependencyDashboardApproval": true,
  "rebaseWhen": "conflicted",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "automerge": false
}
